generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DISCONTINUED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum PriceType {
  COST
  RETAIL
  WHOLESALE
  SALE
  MAP
}

enum ChannelCode {
  COLORIDA
  PRINTSTUDIO
  RDUENDE
  VITRINAS
  AMAZON
  MIRAVIA
  MANOMANO
  OTHER
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RESERVATION
  RELEASE
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  PDF
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  COLOR
  DATE
  SELECT
  MULTISELECT
}

enum CustomizationType {
  TEXT
  IMAGE
  LOGO
  COLOR
  SIZE
  POSITION
  TECHNIQUE
  FILE
}

enum RuleStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum RecommendationSessionStatus {
  STARTED
  COMPLETED
  ABANDONED
}

enum RecommendationEventType {
  IMPRESSION
  CLICK
  ADD_TO_PACK
  REMOVE_FROM_PACK
  FAVORITE
  PURCHASE
  DISMISS
}

enum KnowledgeNodeType {
  CONCEPT
  NEED
  SOLUTION
  SOLUTION_STEP
  AUDIENCE
  OCCASION
  BUSINESS_TYPE
  OBJECTIVE
  STYLE
  MATERIAL
  TECHNIQUE
}

enum KnowledgeRelationType {
  REQUIRES
  SUGGESTS
  SOLVES
  PART_OF
  RELATED_TO
  SUITABLE_FOR
  ALTERNATIVE_TO
  COMPLEMENTS
  PRECEDES
  DEPENDS_ON
  USED_FOR
  PRODUCES
}

enum KnowledgeEvidenceType {
  MANUAL
  RULE
  IMPORT
  AI
  BEHAVIOR
}

enum KnowledgeEventType {
  QUERY_RECEIVED
  NODE_MATCHED
  EDGE_TRAVERSED
  PRODUCT_CANDIDATE
  PRODUCT_SCORED
  PRODUCT_SELECTED
  PRODUCT_REJECTED
  EXPLANATION_GENERATED
}

model Supplier {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  taxId         String?
  email         String?
  phone         String?
  website       String?
  active        Boolean        @default(true)
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  products      Product[]
  priceLists    PriceList[]
  importSources ImportSource[]

  @@index([active])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  website   String?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Category {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  parentId    String?
  position    Int               @default(0)
  active      Boolean           @default(true)
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]        @relation("CategoryTree")
  products    ProductCategory[]

  @@index([parentId])
  @@index([active, position])
}

model Product {
  id                  String                 @id @default(cuid())
  supplierId          String?
  brandId             String?
  sku                 String?                @unique
  supplierReference   String?
  name                String
  slug                String                 @unique
  shortDescription    String?
  description         String?
  aiDescription       String?
  status              ProductStatus          @default(DRAFT)
  productType         String?
  primaryColor        String?
  material            String?
  weightGrams         Int?
  widthMm             Int?
  heightMm            Int?
  depthMm             Int?
  customizable        Boolean                @default(false)
  featured            Boolean                @default(false)
  popularityScore     Decimal                @default(0) @db.Decimal(10, 4)
  recommendationScore Decimal                @default(0) @db.Decimal(10, 4)
  metadata            Json?
  searchDocument      String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  supplier            Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  brand               Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categories          ProductCategory[]
  variants            ProductVariant[]
  media               ProductMedia[]
  attributes          ProductAttribute[]
  tags                ProductTag[]
  audiences           ProductAudience[]
  occasions           ProductOccasion[]
  emotions            ProductEmotion[]
  professions         ProductProfession[]
  interests           ProductInterest[]
  seasons             ProductSeason[]
  customizations      ProductCustomization[]
  prices              Price[]
  inventoryItems      Inventory[]
  packItems           PackItem[]
  recommendationItems RecommendationItem[]
  embeddings          ProductEmbedding[]
  importRecords       ImportRecord[]
  relationsFrom       ProductRelation[]      @relation("ProductRelationsFrom")
  relationsTo         ProductRelation[]      @relation("ProductRelationsTo")
  knowledgeLinks      KnowledgeProductLink[]

  @@index([supplierId])
  @@index([brandId])
  @@index([status])
  @@index([customizable])
  @@index([featured])
  @@index([name])
  @@index([supplierReference])
}

model ProductVariant {
  id             String               @id @default(cuid())
  productId      String
  sku            String               @unique
  name           String?
  status         VariantStatus        @default(ACTIVE)
  barcode        String?
  weightGrams    Int?
  widthMm        Int?
  heightMm       Int?
  depthMm        Int?
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues   VariantOptionValue[]
  prices         Price[]
  inventoryItems Inventory[]
  media          ProductMedia[]

  @@index([productId])
  @@index([status])
  @@index([barcode])
}

model Option {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  position  Int           @default(0)
  values    OptionValue[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model OptionValue {
  id        String               @id @default(cuid())
  optionId  String
  value     String
  slug      String
  position  Int                  @default(0)
  metadata  Json?
  option    Option               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants  VariantOptionValue[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([optionId, slug])
  @@index([optionId, position])
}

model VariantOptionValue {
  variantId     String
  optionValueId String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   OptionValue    @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  position   Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, isPrimary])
}

model MediaAsset {
  id         String         @id @default(cuid())
  type       MediaType
  url        String
  storageKey String?
  fileName   String?
  mimeType   String?
  sizeBytes  Int?
  width      Int?
  height     Int?
  altText    String?
  metadata   Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  products   ProductMedia[]
}

model ProductMedia {
  productId String
  mediaId   String
  variantId String?
  position  Int             @default(0)
  isPrimary Boolean         @default(false)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     MediaAsset      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@index([variantId])
  @@index([productId, isPrimary, position])
}

model Attribute {
  id         String             @id @default(cuid())
  name       String
  slug       String             @unique
  dataType   AttributeDataType
  unit       String?
  filterable Boolean            @default(true)
  searchable Boolean            @default(true)
  metadata   Json?
  values     AttributeValue[]
  products   ProductAttribute[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model AttributeValue {
  id           String             @id @default(cuid())
  attributeId  String
  value        String
  numericValue Decimal?           @db.Decimal(18, 6)
  booleanValue Boolean?
  colorHex     String?
  metadata     Json?
  attribute    Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products     ProductAttribute[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([attributeId, value])
  @@index([attributeId])
}

model ProductAttribute {
  productId        String
  attributeId      String
  attributeValueId String?
  textValue        String?
  numericValue     Decimal?        @db.Decimal(18, 6)
  booleanValue     Boolean?
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute        Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: SetNull)

  @@id([productId, attributeId])
  @@index([attributeId])
  @@index([attributeValueId])
}

model Tag {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  tagType   String?
  products  ProductTag[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model ProductTag {
  productId String
  tagId     String
  weight    Decimal @default(1) @db.Decimal(8, 4)
  source    String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId, weight])
}

model Audience {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  products  ProductAudience[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model ProductAudience {
  productId  String
  audienceId String
  weight     Decimal  @default(1) @db.Decimal(8, 4)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  audience   Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@id([productId, audienceId])
  @@index([audienceId, weight])
}

model Occasion {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  products  ProductOccasion[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model ProductOccasion {
  productId  String
  occasionId String
  weight     Decimal  @default(1) @db.Decimal(8, 4)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@id([productId, occasionId])
  @@index([occasionId, weight])
}

model Emotion {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  products  ProductEmotion[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model ProductEmotion {
  productId String
  emotionId String
  weight    Decimal @default(1) @db.Decimal(8, 4)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  emotion   Emotion @relation(fields: [emotionId], references: [id], onDelete: Cascade)

  @@id([productId, emotionId])
  @@index([emotionId, weight])
}

model Profession {
  id        String              @id @default(cuid())
  name      String
  slug      String              @unique
  products  ProductProfession[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model ProductProfession {
  productId    String
  professionId String
  weight       Decimal    @default(1) @db.Decimal(8, 4)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@id([productId, professionId])
  @@index([professionId, weight])
}

model Interest {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  products  ProductInterest[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model ProductInterest {
  productId  String
  interestId String
  weight     Decimal  @default(1) @db.Decimal(8, 4)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([productId, interestId])
  @@index([interestId, weight])
}

model Season {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  products  ProductSeason[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model ProductSeason {
  productId String
  seasonId  String
  weight    Decimal @default(1) @db.Decimal(8, 4)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  season    Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@id([productId, seasonId])
  @@index([seasonId, weight])
}

model Customization {
  id            String                 @id @default(cuid())
  name          String
  slug          String                 @unique
  type          CustomizationType
  description   String?
  configuration Json?
  active        Boolean                @default(true)
  products      ProductCustomization[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

model ProductCustomization {
  productId       String
  customizationId String
  required        Boolean       @default(false)
  minQuantity     Int?
  maxQuantity     Int?
  setupCost       Decimal?      @db.Decimal(12, 4)
  unitCost        Decimal?      @db.Decimal(12, 4)
  configuration   Json?
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  customization   Customization @relation(fields: [customizationId], references: [id], onDelete: Cascade)

  @@id([productId, customizationId])
  @@index([customizationId])
}

model SalesChannel {
  id        String      @id @default(cuid())
  code      ChannelCode @unique
  name      String
  active    Boolean     @default(true)
  metadata  Json?
  prices    Price[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model PriceList {
  id         String    @id @default(cuid())
  supplierId String?
  name       String
  currency   String    @default("EUR")
  validFrom  DateTime?
  validTo    DateTime?
  active     Boolean   @default(true)
  metadata   Json?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  prices     Price[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([supplierId, active])
}

model Price {
  id          String          @id @default(cuid())
  productId   String?
  variantId   String?
  channelId   String?
  priceListId String?
  type        PriceType
  currency    String          @default("EUR")
  amount      Decimal         @db.Decimal(12, 4)
  minQuantity Int             @default(1)
  maxQuantity Int?
  validFrom   DateTime?
  validTo     DateTime?
  metadata    Json?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  channel     SalesChannel?   @relation(fields: [channelId], references: [id], onDelete: SetNull)
  priceList   PriceList?      @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([productId, type, minQuantity])
  @@index([variantId, type, minQuantity])
  @@index([channelId])
  @@index([priceListId])
}

model Warehouse {
  id        String          @id @default(cuid())
  name      String
  code      String          @unique
  location  String?
  active    Boolean         @default(true)
  inventory Inventory[]
  movements StockMovement[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Inventory {
  id           String          @id @default(cuid())
  warehouseId  String
  productId    String?
  variantId    String?
  quantity     Int             @default(0)
  reserved     Int             @default(0)
  reorderPoint Int?
  updatedAt    DateTime        @updatedAt
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, variantId])
  @@index([productId])
  @@index([variantId])
}

model StockMovement {
  id          String            @id @default(cuid())
  warehouseId String
  inventoryId String?
  type        StockMovementType
  quantity    Int
  reference   String?
  reason      String?
  metadata    Json?
  createdAt   DateTime          @default(now())
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId, createdAt])
  @@index([inventoryId])
}

model Pack {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  active      Boolean    @default(true)
  minBudget   Decimal?   @db.Decimal(12, 4)
  maxBudget   Decimal?   @db.Decimal(12, 4)
  metadata    Json?
  items       PackItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model PackItem {
  packId    String
  productId String
  quantity  Int     @default(1)
  required  Boolean @default(false)
  position  Int     @default(0)
  rationale String?
  pack      Pack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([packId, productId])
  @@index([productId])
}

model ProductRelation {
  id              String   @id @default(cuid())
  sourceProductId String
  targetProductId String
  relationType    String
  weight          Decimal  @default(1) @db.Decimal(8, 4)
  metadata        Json?
  sourceProduct   Product  @relation("ProductRelationsFrom", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProduct   Product  @relation("ProductRelationsTo", fields: [targetProductId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sourceProductId, targetProductId, relationType])
  @@index([targetProductId, relationType])
}

model RecommendationRule {
  id          String     @id @default(cuid())
  name        String
  description String?
  status      RuleStatus @default(DRAFT)
  priority    Int        @default(100)
  conditions  Json
  actions     Json
  validFrom   DateTime?
  validTo     DateTime?
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, priority])
}

model RecommendationSession {
  id             String                      @id @default(cuid())
  externalUserId String?
  status         RecommendationSessionStatus @default(STARTED)
  query          String?
  answers        Json?
  context        Json?
  budgetMin      Decimal?                    @db.Decimal(12, 4)
  budgetMax      Decimal?                    @db.Decimal(12, 4)
  currency       String                      @default("EUR")
  startedAt      DateTime                    @default(now())
  completedAt    DateTime?
  metadata       Json?
  items          RecommendationItem[]
  events         RecommendationEvent[]

  @@index([externalUserId])
  @@index([status, startedAt])
}

model RecommendationItem {
  id          String                @id @default(cuid())
  sessionId   String
  productId   String
  rank        Int
  score       Decimal               @db.Decimal(10, 6)
  explanation String?
  factors     Json?
  selected    Boolean               @default(false)
  session     RecommendationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now())

  @@unique([sessionId, productId])
  @@index([sessionId, rank])
  @@index([productId])
}

model RecommendationEvent {
  id        String                  @id @default(cuid())
  sessionId String
  productId String?
  type      RecommendationEventType
  value     Decimal?                @db.Decimal(12, 4)
  metadata  Json?
  createdAt DateTime                @default(now())
  session   RecommendationSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([productId, type])
}

model ProductEmbedding {
  id          String                @id @default(cuid())
  productId   String
  provider    String
  model       String
  dimensions  Int
  vector      Float[]
  contentHash String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, provider, model])
  @@index([contentHash])
}

model ImportSource {
  id            String      @id @default(cuid())
  supplierId    String?
  name          String
  type          String
  configuration Json?
  active        Boolean     @default(true)
  supplier      Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  jobs          ImportJob[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ImportJob {
  id            String         @id @default(cuid())
  sourceId      String
  status        String
  fileName      String?
  fileUrl       String?
  totalRows     Int            @default(0)
  processedRows Int            @default(0)
  successRows   Int            @default(0)
  errorRows     Int            @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  log           Json?
  source        ImportSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  records       ImportRecord[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([sourceId, status])
}

model ImportRecord {
  id             String    @id @default(cuid())
  jobId          String
  productId      String?
  externalId     String?
  status         String
  rawData        Json
  normalizedData Json?
  errors         Json?
  job            ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([jobId, status])
  @@index([externalId])
  @@index([productId])
}

model KnowledgeNode {
  id             String                  @id @default(cuid())
  type           KnowledgeNodeType
  name           String
  slug           String                  @unique
  description    String?
  active         Boolean                 @default(true)
  priority       Int                     @default(0)
  metadata       Json?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  outgoingEdges  KnowledgeEdge[]         @relation("KnowledgeEdgeSource")
  incomingEdges  KnowledgeEdge[]         @relation("KnowledgeEdgeTarget")
  productLinks   KnowledgeProductLink[]
  sessionMatches KnowledgeSessionMatch[]

  @@index([type, active])
  @@index([name])
  @@index([priority])
}

model KnowledgeEdge {
  id           String                @id @default(cuid())
  sourceId     String
  targetId     String
  relationType KnowledgeRelationType
  weight       Decimal               @default(1) @db.Decimal(8, 6)
  confidence   Decimal               @default(1) @db.Decimal(8, 6)
  evidenceType KnowledgeEvidenceType @default(MANUAL)
  explanation  String?
  active       Boolean               @default(true)
  validFrom    DateTime?
  validTo      DateTime?
  metadata     Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  source       KnowledgeNode         @relation("KnowledgeEdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target       KnowledgeNode         @relation("KnowledgeEdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationType])
  @@index([sourceId, relationType, active])
  @@index([targetId, relationType, active])
  @@index([weight])
}

model KnowledgeProductLink {
  id           String                @id @default(cuid())
  nodeId       String
  productId    String
  relationType KnowledgeRelationType @default(RELATED_TO)
  weight       Decimal               @default(1) @db.Decimal(8, 6)
  confidence   Decimal               @default(1) @db.Decimal(8, 6)
  evidenceType KnowledgeEvidenceType @default(MANUAL)
  explanation  String?
  active       Boolean               @default(true)
  metadata     Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  node         KnowledgeNode         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([nodeId, productId, relationType])
  @@index([nodeId, active])
  @@index([productId, active])
  @@index([weight])
}

model KnowledgeSession {
  id              String                   @id @default(cuid())
  query           String
  normalizedQuery String?
  context         Json?
  result          Json?
  createdAt       DateTime                 @default(now())
  matches         KnowledgeSessionMatch[]
  events          KnowledgeDecisionEvent[]

  @@index([createdAt])
}

model KnowledgeSessionMatch {
  id        String           @id @default(cuid())
  sessionId String
  nodeId    String
  score     Decimal          @db.Decimal(10, 6)
  reason    String
  metadata  Json?
  createdAt DateTime         @default(now())
  session   KnowledgeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  node      KnowledgeNode    @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([sessionId, nodeId])
  @@index([sessionId, score])
  @@index([nodeId])
}

model KnowledgeDecisionEvent {
  id        String             @id @default(cuid())
  sessionId String
  type      KnowledgeEventType
  sequence  Int
  nodeId    String?
  edgeId    String?
  productId String?
  score     Decimal?           @db.Decimal(12, 6)
  reason    String
  payload   Json?
  createdAt DateTime           @default(now())
  session   KnowledgeSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([sessionId, type])
  @@index([productId])
  @@index([createdAt])
}
