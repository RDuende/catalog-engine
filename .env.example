NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL="postgresql://catalog_user:TU_CLAVE@127.0.0.1:5432/colorida_catalog?schema=public"

IMPORT_STORAGE_PATH="./storage/imports"
IMPORT_BATCH_SIZE=500

ASSET_STORAGE_DRIVER=local
ASSET_STORAGE_PATH="./storage/assets"
ASSET_MAX_FILE_SIZE_MB=250
ASSET_PUBLIC_BASE_URL="http://localhost:3000/api/v1/assets"
ASSET_ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,image/svg+xml,application/pdf,application/postscript,application/zip,application/octet-stream"


# Makito API B2B (no subir las claves reales a Git)
MAKITO_API_BASE_URL=https://apis.makito.es
MAKITO_CLIENT_ID=
MAKITO_CLIENT_SECRET=

# Core Sync Job Engine
SYNC_JOB_CONCURRENCY=1
SYNC_JOB_RETENTION=500

PROVIDER_STORAGE_PATH=storage/providers

CANONICAL_IMPORT_BATCH_SIZE=100

# Production hardening v0.45.1
SYNC_JOB_STORAGE_PATH=storage/jobs
PROVIDER_SNAPSHOT_RETENTION=10
PROVIDER_SNAPSHOT_MAX_AGE_DAYS=30

# AI Gateway v0.70.1
AI_PROVIDER=openai
OPENAI_MODEL=gpt-5-mini
OPENAI_API_BASE_URL=https://api.openai.com/v1
AI_STRICT_MODE=false

# Rai Runtime legacy retirement gate
# auto: bloquea en test/staging/preproduction y mantiene en development/production
# enabled: fuerza compatibilidad legacy con advertencia
# disabled: bloquea run(), runContract() y POST /rai-runtime/run
APP_ENV=development
RAI_RUNTIME_LEGACY_ENTRYPOINTS=auto

# M2.7: retirada segura de los puntos de entrada legacy.
# Ventana mínima sin uso legacy antes de poder retirar el código (7 días por defecto).
RAI_RUNTIME_RETIREMENT_OBSERVATION_HOURS=168
# Volumen mínimo de llamadas canónicas observado durante la ventana.
RAI_RUNTIME_RETIREMENT_MIN_CANONICAL_CALLS=1000

# Almacenamiento local de imágenes importadas de proveedores
CATALOG_MEDIA_DIR=.data/catalog-media
