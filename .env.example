NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL="postgresql://catalog_user:TU_CLAVE@127.0.0.1:5432/colorida_catalog?schema=public"

IMPORT_STORAGE_PATH="./storage/imports"
