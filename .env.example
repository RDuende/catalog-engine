NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL="postgresql://catalog_user:TU_CLAVE@127.0.0.1:5432/colorida_catalog?schema=public"

IMPORT_STORAGE_PATH="./storage/imports"
IMPORT_BATCH_SIZE=500

ASSET_STORAGE_DRIVER=local
ASSET_STORAGE_PATH="./storage/assets"
ASSET_MAX_FILE_SIZE_MB=250
ASSET_PUBLIC_BASE_URL="http://localhost:3000/api/v1/assets"
ASSET_ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,image/svg+xml,application/pdf,application/postscript,application/zip,application/octet-stream"


# Makito API B2B (no subir las claves reales a Git)
MAKITO_API_BASE_URL=https://apis.makito.es
MAKITO_CLIENT_ID=
MAKITO_CLIENT_SECRET=

# Core Sync Job Engine
SYNC_JOB_CONCURRENCY=1
SYNC_JOB_RETENTION=500

PROVIDER_STORAGE_PATH=storage/providers

CANONICAL_IMPORT_BATCH_SIZE=100

# Production hardening v0.45.1
SYNC_JOB_STORAGE_PATH=storage/jobs
PROVIDER_SNAPSHOT_RETENTION=10
PROVIDER_SNAPSHOT_MAX_AGE_DAYS=30
