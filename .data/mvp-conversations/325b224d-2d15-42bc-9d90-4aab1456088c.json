  "messages": [
    {
      "id": "963ba62c-ce94-4ec4-beaf-ed753c10c72c",
      "role": "USER",
      "text": "un regalo de comunión para el hijo de mi vecino",
      "createdAt": "2026-08-02T16:56:11.339Z"
    },
    {
      "id": "15f2bacb-ad15-491b-bd1b-ae3205976163",
      "role": "RAI",
      "text": "¡Qué detalle! ¿Qué edad tiene aproximadamente?",
      "createdAt": "2026-08-02T16:56:14.417Z"
    },
    {
      "id": "40d74761-01bb-4c00-b9b7-270fd1b8dfc0",
      "role": "USER",
      "text": "12",
      "createdAt": "2026-08-02T16:56:21.750Z"
    },
    {
      "id": "63f89271-f03c-41be-9bde-20ad03a2fb3c",
      "role": "RAI",
      "text": "Perfecto, tiene 12 años. ¿Qué aficiones o intereses tiene?",
      "createdAt": "2026-08-02T16:56:23.754Z"
    },
    {
      "id": "32dac4cb-23e0-43ed-ac0b-3c8c7ea948c6",
      "role": "USER",
      "text": "futbol",
      "createdAt": "2026-08-02T16:56:29.460Z"
    },
    {
      "id": "c7dd6933-70bb-4de6-b9c7-8867017e0a5f",
      "role": "RAI",
      "text": "¡Genial, le gusta el fútbol! ¿Qué presupuesto aproximado tienes?",
      "createdAt": "2026-08-02T16:56:32.845Z"
    },
    {
      "id": "cc61f581-f682-4613-ac4b-61252d73f340",
      "role": "USER",
      "text": "50 €",
      "createdAt": "2026-08-02T16:56:40.569Z"
    },
    {
      "id": "24f0e6fc-1db2-47a4-a278-f0d25688357c",
      "role": "RAI",
      "text": "Perfecto, hasta 50 €. ¿Tiene algún equipo o jugador de fútbol favorito?",
      "createdAt": "2026-08-02T16:56:44.619Z"
    },
    {
      "id": "101a1753-ae1b-4ea3-a039-c9117a0b8fae",
      "role": "USER",
      "text": "FC Cartagena",
      "createdAt": "2026-08-02T16:56:58.060Z"
    },
    {
      "id": "55e4f4ca-c34a-454c-bb73-728e2ca048d7",
      "role": "RAI",
      "text": "¡Perfecto, es seguidor del FC Cartagena! ¿Prefieres un regalo útil o un recuerdo más emotivo de su comunión?",
      "createdAt": "2026-08-02T16:57:02.027Z"
    },
    {
      "id": "b2d97390-6988-49f4-9ddb-0e6a84c73567",
      "role": "USER",
      "text": "recuerdo",
      "createdAt": "2026-08-02T16:57:09.340Z"
    },
    {
      "id": "924d0ac5-11ab-4127-b076-f7dc3ecaefd2",
      "role": "RAI",
      "text": "¿Te gustaría que el recuerdo llevara una dedicatoria especial por su comunión?",
      "createdAt": "2026-08-02T16:57:13.291Z"
    },
    {
      "id": "36357350-5c5e-4e82-a81a-578a1480047d",
      "role": "USER",
      "text": "sí",
      "createdAt": "2026-08-02T16:57:18.402Z"
    },
    {
      "id": "ffc124e7-fc09-4b89-92bb-b04d1df22e94",
      "role": "RAI",
      "text": "¿Qué te gustaría transmitirle en la dedicatoria?",
      "createdAt": "2026-08-02T16:57:20.562Z"
    },
    {
      "id": "c22d4704-5888-4ec6-8600-31b56dc6ed36",
      "role": "USER",
      "text": "que siempre nos acordaremos de él",
      "createdAt": "2026-08-02T16:57:35.798Z"
    },
    {
      "id": "ed44110f-6fa9-434a-829e-9ac169b20177",
      "role": "RAI",
      "text": "Qué mensaje tan bonito: «Siempre nos acordaremos de ti». ¿Tienes alguna foto suya para personalizar el recuerdo?",
      "createdAt": "2026-08-02T16:57:38.482Z"
    },
    {
      "id": "d446714d-bd76-40df-8c9b-0ce089562772",
      "role": "USER",
      "text": "sí",
      "createdAt": "2026-08-02T16:57:45.259Z"
    },
    {
      "id": "65fedcc0-a82a-43a1-aa59-5d38f4568820",
      "role": "RAI",
      "text": "Perfecto, podremos usar esa foto para personalizar el recuerdo. ¿Quieres que te muestre propuestas?",
      "createdAt": "2026-08-02T16:57:48.215Z"
    },
    {
      "id": "23f8efd5-ab6d-427f-8915-ab2f3cbffb0f",
      "role": "RAI",
      "text": "Ya tengo preparadas tres propuestas para este regalo.",
      "createdAt": "2026-08-02T16:57:52.159Z"
    }
  ],
  "createdAt": "2026-08-02T16:56:14.417Z",
  "updatedAt": "2026-08-02T16:57:52.159Z"
