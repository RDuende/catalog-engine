  "messages": [
    {
      "id": "59a4b26c-771c-493a-abd0-370fb1a8b4ef",
      "role": "USER",
      "text": "un regalo para la comunion de mi ahijado de 12 años",
      "createdAt": "2026-08-02T21:59:38.609Z"
    },
    {
      "id": "f045412a-a759-4621-a944-6f5ec520387b",
      "role": "RAI",
      "text": "¡Qué ocasión tan especial! ¿Qué aficiones o intereses tiene tu ahijado?",
      "createdAt": "2026-08-02T21:59:42.121Z"
    },
    {
      "id": "bde3a64b-b5d8-469f-8ac4-39d32aee43b0",
      "role": "USER",
      "text": "1",
      "createdAt": "2026-08-02T21:59:48.428Z"
    },
    {
      "id": "01bda66e-8135-4b29-b9c4-8e8ac3b172ae",
      "role": "RAI",
      "text": "No he entendido a qué te refieres con «1». ¿Cuál es la afición principal de tu ahijado?",
      "createdAt": "2026-08-02T21:59:52.656Z"
    },
    {
      "id": "6fd0ea54-8281-417e-9a38-7c4915f63ac3",
      "role": "USER",
      "text": "mi ahijado",
      "createdAt": "2026-08-02T22:00:04.240Z"
    },
    {
      "id": "8428684a-a5a6-435a-811b-2b5959c62b07",
      "role": "RAI",
      "text": "Entendido, es para tu ahijado de 12 años por su comunión. ¿Qué presupuesto aproximado tienes?",
      "createdAt": "2026-08-02T22:00:07.914Z"
    },
    {
      "id": "cc1d6f56-795d-4eee-afa6-38ffe5b165ca",
      "role": "USER",
      "text": "ninguna",
      "createdAt": "2026-08-02T22:07:06.776Z"
    },
    {
      "id": "e2df3bd3-fbc8-487f-9f11-b3d9a5354701",
      "role": "RAI",
      "text": "Sin problema, no fijamos presupuesto por ahora. ¿Cómo es él: creativo, aventurero, deportista o más tranquilo?",
      "createdAt": "2026-08-02T22:07:11.958Z"
    }
