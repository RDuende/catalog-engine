    {
      "id": "0fdca0ee-fa84-49ee-abe3-2f7d975b1315",
      "role": "USER",
      "text": "una taza personalizada para una compañera de trabajo",
      "createdAt": "2026-08-02T16:53:51.654Z"
    },
    {
      "id": "a76c3a72-f086-41a0-94f8-df3a4cd998cc",
      "role": "RAI",
      "text": "¡Buena idea! ¿Para qué ocasión quieres regalarle la taza?",
      "createdAt": "2026-08-02T16:53:54.955Z"
    },
    {
      "id": "55c0183d-08ed-47d0-a64e-c53cae61a1ec",
      "role": "USER",
      "text": "una compañera de trabajo",
      "createdAt": "2026-08-02T16:54:16.411Z"
    },
    {
      "id": "2f7c743b-567b-4dc5-bd06-c5e2069b2ea0",
      "role": "RAI",
      "text": "Entendido, es para una compañera de trabajo. ¿Qué motivo quieres celebrar con el regalo?",
      "createdAt": "2026-08-02T16:54:21.258Z"
    },
    {
      "id": "84a7df98-59b7-4749-a30c-57715f4bbd23",
      "role": "USER",
      "text": "1",
      "createdAt": "2026-08-02T16:54:24.739Z"
    },
    {
      "id": "85c42ef8-10a2-42fb-b1c8-7305ec20542a",
      "role": "RAI",
      "text": "No he entendido qué significa «1». ¿Es por cumpleaños, despedida, agradecimiento u otra ocasión?",
      "createdAt": "2026-08-02T16:54:28.733Z"
    },
    {
      "id": "1564d9fe-17e2-4975-851d-d7a6ea172adc",
      "role": "USER",
      "text": "el amigo invisible",
      "createdAt": "2026-08-02T16:54:36.561Z"
    },
    {
      "id": "f966bce2-bd35-4168-a3dc-0283af4c1525",
      "role": "RAI",
      "text": "Perfecto, es para el amigo invisible. ¿Qué gustos o aficiones tiene tu compañera?",
      "createdAt": "2026-08-02T16:54:41.022Z"
