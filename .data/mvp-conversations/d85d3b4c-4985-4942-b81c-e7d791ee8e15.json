                "briefVersion": 1,
                "title": "El poder que siempre estuvo dentro",
                "logline": "la protagonista descubren que su mayor poder aparece cuando confían y actúan en equipo.",
                "premise": "En un universo inspirado en un mundo creado especialmente para ellas, cada protagonista recibe una habilidad diferente. Una amenaza separa las piezas de un emblema y solo podrán recuperarlas combinando sus talentos.",
                "emotionalPromise": "Celebrar que ser diferentes hace más fuerte el vínculo que las une.",
                "centralConflict": "Cada protagonista intenta resolver la misión sola y descubre que ninguna habilidad está completa por separado.",
                "resolution": "Al unir sus poderes, completan el emblema, salvan su mundo y comprenden que siempre forman el mejor equipo.",
                "characters": [
                  {
                    "role": "PROTAGONIST",
                    "participantId": "4744ddb3-5f80-4c32-8280-3064c2dfe33a",
                    "name": "Protagonista 1",
                    "description": "Tiene una habilidad única que se completa con la de la otra protagonista.",
                    "definingTrait": "talento complementario"
                  },
                  {
                    "role": "SYMBOL",
                    "name": "El vínculo",
                    "description": "Un símbolo que solo se completa cuando las protagonistas colaboran.",
                    "definingTrait": "unión"
                  }
                ],
                "visualHooks": [
                  "emblema dividido que se une",
                  "poderes de colores complementarios",
                  "pose final de equipo"
