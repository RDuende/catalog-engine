{
  "name": "catalog-engine",
  "version": "0.71.3-rc1-quality-hotfix1",
  "private": true,
  "description": "Motor de catálogo y recomendaciones de RecuerdArte",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "seed:catalog": "tsx src/scripts/seed-catalog.ts",
    "seed:knowledge": "tsx src/scripts/seed-knowledge.ts",
    "seed:all": "npm run seed:catalog && npm run seed:knowledge",
    "knowledge:products": "tsx src/scripts/seed-education-products.ts",
    "knowledge:import": "tsx src/scripts/import-knowledge.ts",
    "knowledge:setup": "npm run knowledge:products && npm run knowledge:import",
    "import:sample": "tsx src/scripts/import-sample.ts",
    "knowledge:build": "tsx src/scripts/build-knowledge.ts",
    "catalog:analyze": "tsx src/cli/analyze-catalog.ts",
    "test:analyzer": "tsx --test src/modules/catalog-analyzer/*.test.ts",
    "catalog:blocks": "tsx src/cli/detect-blocks.ts",
    "test:block-detector": "tsx --test src/modules/block-detector/*.test.ts",
    "catalog:interpret": "tsx src/cli/interpret-catalog.ts",
    "test:pattern-engine": "tsx --test src/modules/pattern-engine/*.test.ts",
    "test:ast-builder": "tsx --test src/modules/ast-builder/*.test.ts",
    "test:interpreter": "tsx --test src/modules/catalog-interpreter/*.test.ts",
    "test:catalog-intelligence": "npm run test:block-detector && npm run test:pattern-engine && npm run test:ast-builder && npm run test:interpreter",
    "catalog:compile": "tsx src/cli/compile-catalog.ts",
    "test:core-foundation": "tsx --test src/core/*.test.ts src/core/lexer/*.test.ts src/core/semantic/*.test.ts src/core/canonical/*.test.ts src/core/enrichment/*.test.ts src/core/knowledge/*.test.ts src/core/recommendation/*.test.ts src/core/intent/*.test.ts src/modules/intent-api/*.test.ts src/core/dna/*.test.ts src/core/capability/*.test.ts src/core/solution/*.test.ts src/core/recipe/*.test.ts src/modules/intent-api/*.test.ts",
    "test:all": "npm run test:catalog-intelligence && npm run test:core-foundation && npm run test:knowledge-index && npm run test:knowledge-graph && npm run test:canonical-product && npm run test:recommendation-engine && npm run test:semantic-taxonomy && npm run test:business-decision && npm run test:import-management && npm run test:document-intelligence",
    "test:semantic": "tsx --test src/core/semantic/*.test.ts",
    "test": "npm run test:all",
    "test:intent": "tsx --test src/core/intent/*.test.ts",
    "test:api": "tsx --test src/modules/intent-api/*.test.ts",
    "test:foundation": "tsx --test src/core/dna/*.test.ts src/core/capability/*.test.ts src/core/solution/*.test.ts src/core/recipe/*.test.ts src/core/reasoning/*.test.ts src/core/conversation/*.test.ts src/core/creativity/*.test.ts src/modules/intent-api/*.test.ts",
    "test:knowledge-v2": "tsx --test src/core/knowledge/*.test.ts",
    "test:reasoning": "tsx --test src/core/reasoning/*.test.ts",
    "test:conversation": "tsx --test src/core/conversation/*.test.ts src/core/creativity/*.test.ts",
    "test:playground": "tsx --test src/modules/rai-playground/*.test.ts",
    "test:critical": "tsx --test src/core/dna/*.test.ts src/core/capability/*.test.ts src/core/solution/*.test.ts src/core/recipe/*.test.ts src/modules/intent-api/*.test.ts",
    "test:functional": "npm run test:conversation && npm run test:reasoning && npm run test:knowledge-v2 && npm run test:playground",
    "test:agent": "tsx --test src/modules/rai-agent/*.test.ts",
    "test:knowledge-index": "tsx --test src/modules/catalog-knowledge/*.test.ts",
    "test:knowledge-graph": "tsx --test src/modules/catalog-graph/*.test.ts",
    "test:canonical-product": "tsx --test src/modules/canonical-product/*.test.ts",
    "test:recommendation-engine": "tsx --test src/modules/recommendation-engine/*.test.ts src/modules/recommendation-engine/engine/*.test.ts",
    "test:semantic-taxonomy": "tsx --test src/modules/semantic-taxonomy/*.test.ts",
    "test:business-decision": "tsx --test src/modules/business-decision/*.test.ts",
    "test:import-management": "tsx --test src/modules/import-management/*.test.ts",
    "test:document-intelligence": "tsx --test src/modules/document-intelligence/*.test.ts",
    "test:providers": "tsx --test src/modules/provider-engine/*.test.ts",
    "canonical:install": "tsx src/scripts/install-canonical-catalog.ts",
    "test:canonical-catalog": "tsx --test src/modules/canonical-catalog/*.test.ts",
    "test:rate-limiter": "tsx --test src/modules/provider-engine/provider-rate-limiter.test.ts",
    "test:core-sync": "tsx --test src/modules/core-sync/*.test.ts",
    "test:knowledge-foundation": "tsx --test src/modules/knowledge-graph-v2/*.test.ts",
    "knowledge:build:v2": "tsx src/scripts/build-knowledge-v2.ts",
    "test:knowledge-builder": "tsx --test src/modules/knowledge-graph-v2/*.test.ts",
    "test:knowledge-intelligence": "tsx --test src/modules/knowledge-graph-v2/*.test.ts",
    "knowledge:dictionary:sync": "tsx src/scripts/sync-knowledge-dictionary.ts",
    "test:semantic-query": "tsx --test src/modules/knowledge-graph-v2/semantic-query.test.ts",
    "commercial-memory:install": "tsx src/scripts/install-commercial-memory.ts",
    "test:commercial-memory": "tsx --test src/modules/commercial-memory/*.test.ts",
    "test:rai-commercial": "tsx --test src/modules/rai-commercial/*.test.ts",
    "test:sales-brain": "tsx --test src/modules/sales-brain/*.test.ts",
    "test:proposal-pricing": "tsx --test src/modules/proposal-pricing/*.test.ts",
    "test:production-intelligence": "tsx --test src/modules/production-intelligence/*.test.ts",
    "test:rai-workspace": "tsx --test src/modules/rai-workspace/*.test.ts",
    "test:rai-commercial-os": "tsx --test src/modules/sales-brain/*.test.ts src/modules/rai-workspace/*.test.ts",
    "test:ai-gateway": "tsx --test src/modules/ai-gateway/*.test.ts",
    "test:hybrid-conversation": "tsx --test src/modules/ai-gateway/*.test.ts src/modules/sales-brain/hybrid-conversation.test.ts",
    "test:rai-runtime": "tsx --test src/modules/rai-runtime/*.test.ts",
    "test:commercial-context": "tsx --test src/core/commercial-context/*.test.ts",
    "quality:architecture": "node scripts/quality/check-architecture.mjs",
    "quality:secrets": "node scripts/quality/check-secrets.mjs",
    "quality:tests": "node scripts/quality/check-critical-tests.mjs",
    "quality": "npm run quality:architecture && npm run quality:secrets && npm run quality:tests",
    "test:v1-critical": "npm run test:commercial-context && npm run test:ai-gateway && npm run test:hybrid-conversation && npm run test:sales-brain && npm run test:rai-runtime && npm run test:recommendation-engine",
    "check:fast": "npm run quality && npm run typecheck && npm run test:v1-critical",
    "check": "npm run check:fast && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@sinclair/typebox": "^0.34.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "xlsx": "^0.18.5",
    "pdfjs-dist": "^5.4.149"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "prisma": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true
  }
}
